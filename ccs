#!/bin/sh
# ccs - Claude Code Switch
# Minimal provider switching for Claude Code
# https://github.com/maxgfr/claude-code-switch
set -eu

VERSION="1.3.0"
CONFIG_DIR="${HOME}/.claude-provider"
CONFIG_FILE="${CONFIG_DIR}/config"
ACTIVE_FILE="${CONFIG_DIR}/active"
HOOKS_DIR="${CONFIG_DIR}/hooks"
NOTIFY_STATE_FILE="${CONFIG_DIR}/notify-state"
MODELS_CACHE="${CONFIG_DIR}/models-cache"
MODELS_CACHE_TTL=604800   # 7 days — context windows change on model releases
SETTINGS_BACKUP="${CONFIG_DIR}/settings-backup.json"
CLAUDE_SETTINGS="${HOME}/.claude/settings.json"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# --- Colors (only when stdout is a terminal) ---
if [ -t 1 ]; then
    C_RESET=$(printf '\033[0m')
    C_BOLD=$(printf '\033[1m')
    C_RED=$(printf '\033[31m')
    C_GREEN=$(printf '\033[32m')
    C_YELLOW=$(printf '\033[33m')
    C_CYAN=$(printf '\033[36m')
    C_DIM=$(printf '\033[2m')
else
    C_RESET="" C_BOLD="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN="" C_DIM=""
fi

# --- Utilities ---

die() {
    printf '%s%s%s %s\n' "${C_RED}" "error:" "${C_RESET}" "$*" >&2
    exit 1
}

warn() {
    printf '%s%s%s %s\n' "${C_YELLOW}" "warn:" "${C_RESET}" "$*" >&2
}

info() {
    printf '%s>>>%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"
}

mask_key() {
    local key="$1"
    local len
    len=$(printf '%s' "$key" | wc -c | tr -d ' ')
    if [ "$len" -gt 12 ]; then
        local prefix suffix
        prefix=$(printf '%s' "$key" | cut -c1-8)
        suffix=$(printf '%s' "$key" | rev | cut -c1-4 | rev)
        printf '%s...%s' "$prefix" "$suffix"
    elif [ "$len" -gt 0 ]; then
        printf '****'
    else
        printf '(empty)'
    fi
}

# --- Config parser ---

# Parse the INI config file into cfg_<section>_<key> variables
# Also builds PROVIDERS list (space-separated, excluding _defaults)
parse_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        return 1
    fi

    local current_section=""
    PROVIDERS=""

    while IFS= read -r line || [ -n "$line" ]; do
        # Strip leading/trailing whitespace
        line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

        # Skip empty lines and comments
        case "$line" in
            ""|\#*) continue ;;
        esac

        # Section header
        case "$line" in
            \[*\])
                current_section=$(printf '%s' "$line" | sed 's/^\[//;s/\]$//')
                # Validate section name
                case "$current_section" in
                    *[!a-zA-Z0-9_]*)
                        warn "Skipping invalid section name: $current_section"
                        current_section=""
                        ;;
                    _defaults) ;;
                    *)
                        # Add to providers list
                        PROVIDERS="${PROVIDERS:+$PROVIDERS }$current_section"
                        ;;
                esac
                continue
                ;;
        esac

        # Key=value pair
        if [ -n "$current_section" ]; then
            case "$line" in
                *=*)
                    local key value
                    key=$(printf '%s' "$line" | cut -d= -f1)
                    value=$(printf '%s' "$line" | cut -d= -f2-)
                    # Sanitize key
                    case "$key" in
                        *[!a-zA-Z0-9_]*) continue ;;
                    esac
                    eval "cfg_${current_section}_${key}=\"\$value\""
                    ;;
            esac
        fi
    done < "$CONFIG_FILE"
}

# Get a config value
get_cfg() {
    local section="$1" key="$2"
    eval printf '%s' "\"\${cfg_${section}_${key}:-}\""
}

# --- State file ---

write_active() {
    local provider="$1" model="$2" base_url="$3" api_key="$4"
    local opus="$5" sonnet="$6" haiku="$7"
    cat > "$ACTIVE_FILE" <<EOF
PROVIDER=$provider
MODEL=$model
BASE_URL=$base_url
API_KEY=$api_key
OPUS_MODEL=$opus
SONNET_MODEL=$sonnet
HAIKU_MODEL=$haiku
EOF
    chmod 600 "$ACTIVE_FILE"
}

read_active() {
    if [ ! -f "$ACTIVE_FILE" ]; then
        return 1
    fi
    ACTIVE_PROVIDER="" ACTIVE_MODEL="" ACTIVE_BASE_URL="" ACTIVE_API_KEY=""
    ACTIVE_OPUS="" ACTIVE_SONNET="" ACTIVE_HAIKU=""
    while IFS='=' read -r key value; do
        case "$key" in
            PROVIDER)     ACTIVE_PROVIDER="$value" ;;
            MODEL)        ACTIVE_MODEL="$value" ;;
            BASE_URL)     ACTIVE_BASE_URL="$value" ;;
            API_KEY)      ACTIVE_API_KEY="$value" ;;
            OPUS_MODEL)   ACTIVE_OPUS="$value" ;;
            SONNET_MODEL) ACTIVE_SONNET="$value" ;;
            HAIKU_MODEL)  ACTIVE_HAIKU="$value" ;;
        esac
    done < "$ACTIVE_FILE"
    # Fallback: if tiers not set, use main model
    ACTIVE_OPUS="${ACTIVE_OPUS:-$ACTIVE_MODEL}"
    ACTIVE_SONNET="${ACTIVE_SONNET:-$ACTIVE_MODEL}"
    ACTIVE_HAIKU="${ACTIVE_HAIKU:-$ACTIVE_MODEL}"
}

# --- Validation ---

require_config() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        # Try to find config.template: script dir, Homebrew pkgshare, or inline
        local template=""
        if [ -f "${SCRIPT_DIR}/config.template" ]; then
            template="${SCRIPT_DIR}/config.template"
        elif [ -f "$(brew --prefix 2>/dev/null)/share/claude-code-switch/config.template" ]; then
            template="$(brew --prefix)/share/claude-code-switch/config.template"
        fi
        if [ -n "$template" ]; then
            cp "$template" "$CONFIG_FILE"
        else
            cat > "$CONFIG_FILE" <<'TMPL'
[_defaults]
provider=anthropic
model=claude-sonnet-5
auto_context=true

[anthropic]
base_url=
api_key=
model=claude-sonnet-5

[openrouter]
base_url=https://openrouter.ai/api
api_key=
model=anthropic/claude-sonnet-4

[deepseek]
base_url=https://api.deepseek.com/anthropic
api_key=
model=deepseek-chat
opus_model=deepseek-reasoner

[zai]
base_url=https://api.z.ai/api/anthropic
api_key=
model=glm-5.1
opus_model=glm-5.1
haiku_model=glm-4.7

[kimi]
base_url=https://api.moonshot.ai/anthropic
api_key=
model=kimi-k2.5

[qwen]
base_url=https://dashscope-intl.aliyuncs.com/apps/anthropic
api_key=
