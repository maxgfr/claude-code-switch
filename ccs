#!/bin/sh
# ccs - Claude Code Switch
# Minimal provider switching for Claude Code
# https://github.com/maxgfr/claude-code-switch
set -eu

VERSION="1.7.0"
CONFIG_DIR="${HOME}/.claude-provider"
CONFIG_FILE="${CONFIG_DIR}/config"
ACTIVE_FILE="${CONFIG_DIR}/active"
HOOKS_DIR="${CONFIG_DIR}/hooks"
NOTIFY_STATE_FILE="${CONFIG_DIR}/notify-state"
MODELS_CACHE="${CONFIG_DIR}/models-cache"
MODELS_CACHE_TTL=604800   # 7 days — context windows change on model releases
SETTINGS_BACKUP="${CONFIG_DIR}/settings-backup.json"
CLAUDE_DIR="${HOME}/.claude"
CLAUDE_SETTINGS="${CLAUDE_DIR}/settings.json"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# --- Keep-awake state (see `ccs caffeine`) ---
# Resolved per launch, never persisted: CAFFEINE_CMD holds the wrapper command
# as space-free words, spliced unquoted into the exec in cmd_launch.
CAFFEINE_CMD=""                               # e.g. "caffeinate -ims", empty = no wrapper
CAFFEINE_OVERRIDE=""                          # --caffeine / --no-caffeine, beats the config
# Where WSL identifies itself. Overridable only so the test suite can reach the
# WSL branch from a runner that is not WSL — there is no reason to set it.
CCS_OSRELEASE="${CCS_OSRELEASE:-/proc/sys/kernel/osrelease}"

# --- Sync constants ---
SYNC_DIR="${CONFIG_DIR}/sync"                 # git working copy mirroring the remote
SYNC_BACKUP_DIR="${CONFIG_DIR}/sync-backup"   # ~/.claude snapshots, one per apply
SYNC_STATE_FILE="${CONFIG_DIR}/sync-state"
SYNC_MANIFEST=".ccs-sync"
SYNC_HOME_TOKEN="__CCS_HOME__"                # stands in for $HOME in the remote
SYNC_TIMEOUT=5                                # seconds the auto sync may steal from a launch

# The allow-list of everything ccs backs up, relative to ~/.claude. It is
# deliberately an allow-list: a real ~/.claude runs to gigabytes of transcripts,
# job state and caches, none of which help you rebuild a good install. Anything
# absent from this line is never read and never written — projects/, jobs/,
# transcripts/, history.jsonl, file-history/, shell-snapshots/, telemetry/,
# .credentials.json, settings.local.json and ~/.claude.json included.
SYNC_PATHS="CLAUDE.md settings.json agents commands skills output-styles hooks plugins/installed_plugins.json plugins/known_marketplaces.json"

# --- Colors (only when stdout is a terminal) ---
if [ -t 1 ]; then
    C_RESET=$(printf '\033[0m')
    C_BOLD=$(printf '\033[1m')
    C_RED=$(printf '\033[31m')
    C_GREEN=$(printf '\033[32m')
    C_YELLOW=$(printf '\033[33m')
    C_CYAN=$(printf '\033[36m')
    C_DIM=$(printf '\033[2m')
else
    C_RESET="" C_BOLD="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN="" C_DIM=""
fi

# --- Utilities ---

die() {
    printf '%s%s%s %s\n' "${C_RED}" "error:" "${C_RESET}" "$*" >&2
    exit 1
}

warn() {
    printf '%s%s%s %s\n' "${C_YELLOW}" "warn:" "${C_RESET}" "$*" >&2
}

info() {
    printf '%s>>>%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"
}

mask_key() {
    local key="$1"
    local len
    len=$(printf '%s' "$key" | wc -c | tr -d ' ')
    if [ "$len" -gt 12 ]; then
        local prefix suffix
        prefix=$(printf '%s' "$key" | cut -c1-8)
        suffix=$(printf '%s' "$key" | rev | cut -c1-4 | rev)
        printf '%s...%s' "$prefix" "$suffix"
    elif [ "$len" -gt 0 ]; then
        printf '****'
    else
        printf '(empty)'
    fi
}

# --- Config parser ---

# Parse the INI config file into cfg_<section>_<key> variables
# Also builds PROVIDERS list (space-separated, excluding _defaults)
parse_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        return 1
    fi

    local current_section="" line key value
    PROVIDERS=""

    # Pure parameter expansions, no sed/cut: this runs on every launch and a
    # fork per line made it the slowest thing ccs does by a wide margin.
    while IFS= read -r line || [ -n "$line" ]; do
        # Strip leading/trailing whitespace
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}

        case "$line" in
            # Empty lines and comments
            ""|\#*) continue ;;

            # Section header
            \[*\])
                current_section=${line#\[}
                current_section=${current_section%\]}
                # Validate section name
                case "$current_section" in
                    ""|*[!a-zA-Z0-9_]*)
                        warn "Skipping invalid section name: $current_section"
                        current_section=""
                        ;;
                    # A leading underscore marks a reserved section ([_defaults],
                    # [_sync]): parsed into cfg_* like any other, but never a
                    # provider, so it stays out of `ccs list` and `ccs use`.
                    _*) ;;
                    *)
                        # Add to providers list
                        PROVIDERS="${PROVIDERS:+$PROVIDERS }$current_section"
                        ;;
                esac
                ;;

            # key=value pair — spaces around the = are allowed, as they are in
            # config_set; the value keeps any further = it contains
            *=*)
                [ -n "$current_section" ] || continue
                key=${line%%=*}
                value=${line#*=}
                key=${key%"${key##*[![:space:]]}"}
                value=${value#"${value%%[![:space:]]*}"}
                # Sanitize key
                case "$key" in
                    ""|*[!a-zA-Z0-9_]*) continue ;;
                esac
                eval "cfg_${current_section}_${key}=\"\$value\""
                ;;
        esac
    done < "$CONFIG_FILE"
}

# Get a config value
get_cfg() {
    local section="$1" key="$2"
    eval printf '%s' "\"\${cfg_${section}_${key}:-}\""
}

# --- State file ---

write_active() {
    local provider="$1" model="$2" base_url="$3" api_key="$4"
    local opus="$5" sonnet="$6" haiku="$7" native="${8:-}"
    cat > "$ACTIVE_FILE" <<EOF
PROVIDER=$provider
MODEL=$model
BASE_URL=$base_url
API_KEY=$api_key
OPUS_MODEL=$opus
SONNET_MODEL=$sonnet
HAIKU_MODEL=$haiku
NATIVE=$native
EOF
    chmod 600 "$ACTIVE_FILE"
}

read_active() {
    if [ ! -f "$ACTIVE_FILE" ]; then
        return 1
    fi
    ACTIVE_PROVIDER="" ACTIVE_MODEL="" ACTIVE_BASE_URL="" ACTIVE_API_KEY=""
    ACTIVE_OPUS="" ACTIVE_SONNET="" ACTIVE_HAIKU="" ACTIVE_NATIVE=""
    while IFS='=' read -r key value; do
        case "$key" in
            PROVIDER)     ACTIVE_PROVIDER="$value" ;;
            MODEL)        ACTIVE_MODEL="$value" ;;
            BASE_URL)     ACTIVE_BASE_URL="$value" ;;
            API_KEY)      ACTIVE_API_KEY="$value" ;;
            OPUS_MODEL)   ACTIVE_OPUS="$value" ;;
            SONNET_MODEL) ACTIVE_SONNET="$value" ;;
            HAIKU_MODEL)  ACTIVE_HAIKU="$value" ;;
            # Absent from files written before native mode — empty is correct
            NATIVE)       ACTIVE_NATIVE="$value" ;;
        esac
    done < "$ACTIVE_FILE"
    # Fallback: if tiers not set, use main model
    ACTIVE_OPUS="${ACTIVE_OPUS:-$ACTIVE_MODEL}"
    ACTIVE_SONNET="${ACTIVE_SONNET:-$ACTIVE_MODEL}"
    ACTIVE_HAIKU="${ACTIVE_HAIKU:-$ACTIVE_MODEL}"
}

# --- Validation ---

require_config() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        # Try to find config.template: script dir, Homebrew pkgshare, or inline
        local template=""
        if [ -f "${SCRIPT_DIR}/config.template" ]; then
            template="${SCRIPT_DIR}/config.template"
        elif [ -f "$(brew --prefix 2>/dev/null)/share/claude-code-switch/config.template" ]; then
            template="$(brew --prefix)/share/claude-code-switch/config.template"
        fi
        if [ -n "$template" ]; then
            cp "$template" "$CONFIG_FILE"
        else
            cat > "$CONFIG_FILE" <<'TMPL'
[_defaults]
provider=claude
model=
auto_context=true
caffeine=off

[_sync]
remote=
kind=repo
include_ccs=false
auto_launch=false
auto_hooks=false
prune=true

[claude]
native=true

[anthropic]
base_url=
api_key=
model=claude-sonnet-5

[openrouter]
base_url=https://openrouter.ai/api
api_key=
model=anthropic/claude-sonnet-4

[deepseek]
base_url=https://api.deepseek.com/anthropic
api_key=
model=deepseek-chat
opus_model=deepseek-reasoner

[zai]
base_url=https://api.z.ai/api/anthropic
api_key=
model=glm-5.1
opus_model=glm-5.1
haiku_model=glm-4.7

[kimi]
base_url=https://api.moonshot.ai/anthropic
api_key=
model=kimi-k2.5

[qwen]
base_url=https://dashscope-intl.aliyuncs.com/apps/anthropic
api_key=
model=qwen3.5-plus
haiku_model=qwen3-coder-plus

[minimax]
base_url=https://api.minimax.io/anthropic
api_key=
model=MiniMax-M2.7
haiku_model=MiniMax-M2.5

[doubao]
base_url=https://ark.cn-beijing.volces.com/api/coding
api_key=
model=doubao-seed-code-preview-latest
# Volcengine is not in the llm-models catalogue, so pin the window by hand
context_tokens=262144

[custom]
base_url=
api_key=
model=
TMPL
        fi
        chmod 600 "$CONFIG_FILE"
        info "Created config at $CONFIG_FILE"
        printf '    Edit it to add your API keys: %sccs config%s\n' "${C_BOLD}" "${C_RESET}"
    fi

    # Configs written before native mode have no native provider at all, so
    # `ccs use claude` would die on an unknown provider. Append one instead of
    # asking for a hand edit. Guarded on the key, not the section name, so a
    # config that already declares a native provider is left alone — and so the
    # append happens exactly once. The existing [_defaults] is never touched:
    # an install in place keeps whatever provider it was on.
    if [ -f "$CONFIG_FILE" ] && ! grep -qE '^[[:space:]]*native[[:space:]]*=' "$CONFIG_FILE"; then
        printf '\n# Native login — exactly what running claude on its own does.\n[claude]\nnative=true\n' \
            >> "$CONFIG_FILE"
    fi
}

validate_provider() {
    local provider="$1"
    local p
    for p in $PROVIDERS; do
        if [ "$p" = "$provider" ]; then
            return 0
        fi
    done
    die "Unknown provider '$provider'. Available: $PROVIDERS"
}

validate_api_key() {
    local provider="$1"
    local key
    key=$(get_cfg "$provider" "api_key")
    if [ -z "$key" ]; then
        die "Provider '$provider' has no API key configured. Run: ccs config"
    fi
}

# A native provider configures nothing: claude runs on its own login and ccs
# only wraps it (caffeine, sync). base_url=, api_key= and model= in such a
# section are ignored — there is nothing to inject. It is a config key, not a
# hardcoded section name, so any section can be one.
is_native() {
    [ "$(get_cfg "$1" "native")" = "true" ]
}

resolve_model() {
    local provider="$1" model_arg="${2:-}"
    if [ -n "$model_arg" ]; then
        printf '%s' "$model_arg"
        return
    fi
    local dm
    dm=$(get_cfg "$provider" "model")
    # Backward compat: try sonnet_model, then default_model
    if [ -z "$dm" ]; then dm=$(get_cfg "$provider" "sonnet_model"); fi
    if [ -z "$dm" ]; then dm=$(get_cfg "$provider" "default_model"); fi
    if [ -n "$dm" ]; then
        printf '%s' "$dm"
        return
    fi
    die "No model configured for '$provider'. Specify one: ccs use $provider <model>"
}

# --- Model limits ---
# Claude Code assumes a 200k context window for any model it does not ship in
# its own table, so auto-compact fires far too early on a 1M model (and too
# late on a smaller one). CLAUDE_CODE_MAX_CONTEXT_TOKENS overrides that: it is
# honoured for every model id that does not start with "claude-" — exactly the
# third-party case — and it also silences the "is not a model this version of
# Claude Code recognizes" warning.
#
# Model metadata comes from llm-models (github.com/maxgfr/llm-models), a soft
# dependency in the same spirit as jq for `notify`: present means windows are
# sized automatically, absent means ccs behaves exactly as it did before.
# Answers are cached in $MODELS_CACHE so the launch path stays subprocess-free.

is_uint() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

have_llm_models() {
    command -v llm-models >/dev/null 2>&1
}

# Render a token count for humans: 1000000 -> 1.0M, 204800 -> 204K
fmt_tokens() {
    local n="${1:-}"
    if ! is_uint "$n"; then
        printf '%s' "-"
    elif [ "$n" -ge 1000000 ]; then
        printf '%s.%sM' "$((n / 1000000))" "$(((n % 1000000) / 100000))"
    elif [ "$n" -ge 1000 ]; then
        printf '%sK' "$((n / 1000))"
    else
        printf '%s' "$n"
    fi
}

# cache_lookup <provider> <model> -> "ctx out id age_seconds"
cache_lookup() {
    local now
    [ -f "$MODELS_CACHE" ] || return 1
    now=$(date +%s 2>/dev/null) || return 1
    awk -v p="$1" -v m="$2" -v now="$now" '
        $1 == p && $2 == m { print $3, $4, $6, now - $5; found = 1; exit }
        END { exit !found }
    ' "$MODELS_CACHE"
}

# cache_store <provider> <model> <ctx> <out> <id> — "-" marks an unknown field
cache_store() {
    local provider="$1" model="$2" ctx="$3" out="$4" id="$5"
    local now tmp
    now=$(date +%s 2>/dev/null) || return 0
    tmp=$(mktemp) || return 0
    if [ -f "$MODELS_CACHE" ]; then
        awk -v p="$provider" -v m="$model" '!($1 == p && $2 == m)' "$MODELS_CACHE" > "$tmp"
    fi
    printf '%s %s %s %s %s %s\n' \
        "$provider" "$model" "${ctx:--}" "${out:--}" "$now" "${id:--}" >> "$tmp"
    mv "$tmp" "$MODELS_CACHE"
    chmod 600 "$MODELS_CACHE"
}

# Pull "ctx out id" out of one `llm-models info --json` payload
llm_parse_json() {
    local json="$1" ctx out id
    ctx=$(printf '%s\n' "$json" | awk -F: '/"context_length"/ { gsub(/[^0-9]/, "", $2); print $2; exit }')
    out=$(printf '%s\n' "$json" | awk -F: '/"output_limit"/ { gsub(/[^0-9]/, "", $2); print $2; exit }')
    id=$(printf '%s\n' "$json" | awk -F'"' '/"id"/ { print $4; exit }')
    is_uint "$ctx" || return 1
    printf '%s %s %s' "$ctx" "${out:--}" "${id:--}"
}

# llm_lookup <model> <base_url> -> "ctx out id"
# `resolve --endpoint` (llm-models >= 1.3) answers for the endpoint ccs
# actually calls, which matters: the same model id is published under dozens of
# providers with different limits. Older llm-models fall back to info/find.
llm_lookup() {
    local model="$1" base_url="${2:-}" line json id

    if [ -n "$base_url" ]; then
        line=$(llm-models resolve "$model" --endpoint "$base_url" \
            --field context_length,output_limit,id --quiet 2>/dev/null) || line=""
        if [ -n "$line" ]; then
            printf '%s' "$line" | tr '\t' ' '
            return 0
        fi
    fi

    line=$(llm-models resolve "$model" \
        --field context_length,output_limit,id --quiet 2>/dev/null) || line=""
    if [ -n "$line" ]; then
        printf '%s' "$line" | tr '\t' ' '
        return 0
    fi

    # llm-models < 1.3: exact id first, then the best trailing-segment match
    json=$(llm-models info "$model" --json --quiet 2>/dev/null) || json=""
    if [ -z "$json" ]; then
        id=$(llm-models find --search "$model" --ids-only --quiet 2>/dev/null | awk -v m="$model" '
            { base = $0; sub(/^.*\//, "", base)
              if (tolower(base) == tolower(m)) { print; exit } }') || id=""
        [ -n "$id" ] || return 1
        json=$(llm-models info "$id" --json --quiet 2>/dev/null) || return 1
    fi
    llm_parse_json "$json"
}

# load_limits <provider> <model> [base_url] [refresh]
# Sets CTX_TOKENS, OUT_TOKENS, CTX_SOURCE, CTX_MODEL_ID. Never fails: an
# unknown window simply leaves CTX_TOKENS empty and ccs launches as before.
load_limits() {
    local provider="$1" model="$2" base_url="${3:-}" refresh="${4:-}"
    local cfg_ctx cfg_out ctx="" out="" id="" src="unknown" age="" row fresh

    CTX_TOKENS="" OUT_TOKENS="" CTX_SOURCE="unknown" CTX_MODEL_ID=""
    [ -n "$model" ] || return 0

    # The launch path reads $ACTIVE_FILE and never parses the config, so parse
    # it here or the per-provider overrides below would be invisible.
    if [ -z "${PROVIDERS+x}" ]; then
        parse_config || true
    fi

    if [ "$(get_cfg "_defaults" "auto_context")" = "false" ]; then
        CTX_SOURCE="off"
        return 0
    fi

    cfg_ctx=$(get_cfg "$provider" "context_tokens")
    cfg_out=$(get_cfg "$provider" "max_output_tokens")
    if [ -n "$cfg_ctx" ] && ! is_uint "$cfg_ctx"; then
        warn "ignoring non-numeric context_tokens for '$provider': $cfg_ctx"
        cfg_ctx=""
    fi
    if [ -n "$cfg_out" ] && ! is_uint "$cfg_out"; then
        warn "ignoring non-numeric max_output_tokens for '$provider': $cfg_out"
        cfg_out=""
    fi

    if [ -z "$cfg_ctx" ] || [ -z "$cfg_out" ]; then
        if [ -z "$refresh" ] && row=$(cache_lookup "$provider" "$model"); then
            read -r ctx out id age <<EOF
$row
EOF
            [ "$ctx" = "-" ] && ctx=""
            [ "$out" = "-" ] && out=""
            [ "$id" = "-" ] && id=""
            if is_uint "$age" && [ "$age" -lt "$MODELS_CACHE_TTL" ]; then
                src="cache"
            else
                src="cache (stale)"
            fi
        fi

        # A fresh cache entry is authoritative; anything else asks llm-models.
        if [ "$src" != "cache" ]; then
            if have_llm_models; then
                if fresh=$(llm_lookup "$model" "$base_url"); then
                    read -r ctx out id <<EOF
$fresh
EOF
                    [ "$out" = "-" ] && out=""
                    [ "$id" = "-" ] && id=""
                    src="llm-models"
                    cache_store "$provider" "$model" "$ctx" "$out" "$id"
                fi
            elif [ "$src" = "unknown" ]; then
                src="no llm-models"
            fi
        fi
    fi

    [ -n "$cfg_ctx" ] && { ctx="$cfg_ctx"; src="config"; }
    [ -n "$cfg_out" ] && out="$cfg_out"

    is_uint "$ctx" || ctx=""
    is_uint "$out" || out=""
    # An output limit above the context window is never meaningful.
    if [ -n "$ctx" ] && [ -n "$out" ] && [ "$out" -gt "$ctx" ]; then
        out="$ctx"
    fi
    [ -n "$ctx" ] || { [ "$src" = "no llm-models" ] || src="unknown"; }

    CTX_TOKENS="$ctx"
    OUT_TOKENS="$out"
    CTX_SOURCE="$src"
    CTX_MODEL_ID="$id"
}

# Populate ACTIVE_* from the active state file, falling back to [_defaults].
# Returns 1 when no default provider is configured, 2 when it has no API key —
# callers decide whether that means vanilla claude or a hard error.
load_state() {
    if read_active 2>/dev/null && [ -n "$ACTIVE_PROVIDER" ]; then
        return 0
    fi

    parse_config
    local dp dm base_url api_key opus haiku
    dp=$(get_cfg "_defaults" "provider")
    dm=$(get_cfg "_defaults" "model")
    [ -n "$dp" ] || return 1
    validate_provider "$dp"

    # A native provider has nothing to resolve — and no API key to demand.
    if is_native "$dp"; then
        ACTIVE_PROVIDER="$dp"
        ACTIVE_MODEL="" ACTIVE_BASE_URL="" ACTIVE_API_KEY=""
        ACTIVE_OPUS="" ACTIVE_SONNET="" ACTIVE_HAIKU=""
        ACTIVE_NATIVE="1"
        return 0
    fi

    api_key=$(get_cfg "$dp" "api_key")
    [ -n "$api_key" ] || return 2

    base_url=$(get_cfg "$dp" "base_url")
    opus=$(get_cfg "$dp" "opus_model")
    haiku=$(get_cfg "$dp" "haiku_model")
    if [ -z "$dm" ]; then dm=$(get_cfg "$dp" "model"); fi
    if [ -z "$dm" ]; then dm=$(get_cfg "$dp" "sonnet_model"); fi
    if [ -z "$dm" ]; then dm=$(get_cfg "$dp" "default_model"); fi

    ACTIVE_PROVIDER="$dp"
    ACTIVE_MODEL="$dm"
    ACTIVE_BASE_URL="$base_url"
    ACTIVE_API_KEY="$api_key"
    ACTIVE_OPUS="${opus:-$dm}"
    ACTIVE_SONNET="$dm"
    ACTIVE_HAIKU="${haiku:-$dm}"
    ACTIVE_NATIVE=""
    return 0
}

# --- Commands ---

cmd_use() {
    if [ $# -lt 1 ]; then
        die "Usage: ccs use <provider> [model]"
    fi
    local provider="$1"
    local model_arg="${2:-}"

    parse_config
    validate_provider "$provider"

    # Native login: nothing to resolve, nothing to store, no key to demand.
    if is_native "$provider"; then
        if [ -n "$model_arg" ]; then
            die "Provider '$provider' is the native login and takes no model — claude picks its own (use /model inside it)."
        fi
        write_active "$provider" "" "" "" "" "" "" "1"
        write_defaults "$provider" ""
        info "Switched to ${C_BOLD}${provider}${C_RESET} ${C_DIM}(native login — same as running claude directly)${C_RESET}"
        printf '    Run %sccs%s to start claude with nothing injected\n' "${C_BOLD}" "${C_RESET}"
        return
    fi

    validate_api_key "$provider"

    local model base_url api_key opus haiku
    model=$(resolve_model "$provider" "$model_arg")
    base_url=$(get_cfg "$provider" "base_url")
    api_key=$(get_cfg "$provider" "api_key")
    opus=$(get_cfg "$provider" "opus_model")
    haiku=$(get_cfg "$provider" "haiku_model")

    write_active "$provider" "$model" "$base_url" "$api_key" \
        "${opus:-$model}" "$model" "${haiku:-$model}"
    write_defaults "$provider" "$model"

    # Warm the window cache now so the launch path stays subprocess-free
    load_limits "$provider" "$model" "$base_url"

    if [ -n "$CTX_TOKENS" ]; then
        info "Switched to ${C_BOLD}${provider}${C_RESET} / ${C_CYAN}${model}${C_RESET} ${C_DIM}($(fmt_tokens "$CTX_TOKENS") context)${C_RESET}"
    else
        info "Switched to ${C_BOLD}${provider}${C_RESET} / ${C_CYAN}${model}${C_RESET}"
    fi
    printf '    Run %sccs%s to start claude with this provider\n' "${C_BOLD}" "${C_RESET}"
}

cmd_list() {
    parse_config

    local active_provider=""
    if read_active 2>/dev/null; then
        active_provider="$ACTIVE_PROVIDER"
    fi

    printf "\n"
    printf '  %s%-1s %-14s %-16s %s%s\n' "${C_BOLD}" "" "Provider" "Status" "Model" "${C_RESET}"
    printf '  %-1s %-14s %-16s %s\n' "" "--------------" "----------------" "-------------------------"

    local p
    for p in $PROVIDERS; do
        local key dm status_text status_color marker
        key=$(get_cfg "$p" "api_key")
        dm=$(get_cfg "$p" "model")
        if [ -z "$dm" ]; then dm=$(get_cfg "$p" "sonnet_model"); fi
        if [ -z "$dm" ]; then dm=$(get_cfg "$p" "default_model"); fi
        if is_native "$p"; then
            # No key to configure — it is always ready, and has no model of its own
            status_text="native login"
            status_color="$C_GREEN"
            dm=""
        elif [ -n "$key" ]; then
            status_text="configured"
            status_color="$C_GREEN"
        else
            status_text="not configured"
            status_color="$C_DIM"
        fi
        if [ "$p" = "$active_provider" ]; then
            marker="*"
        else
            marker=" "
        fi
        printf '  %s%s%s %-14s %s%-16s%s %s\n' "${C_BOLD}" "$marker" "${C_RESET}" "$p" "$status_color" "$status_text" "${C_RESET}" "${dm:--}"
    done
    printf "\n"
}

cmd_status() {
    if ! read_active; then
        die "No active provider. Run 'ccs use <provider>' first."
    fi

    printf "\n"
    printf '  %sProvider:%s  %s\n' "${C_BOLD}" "${C_RESET}" "$ACTIVE_PROVIDER"

    # Native login: there is nothing to report but the fact itself — no model,
    # no endpoint, no key, no window. Keep awake still applies, so still print it.
    if [ -n "$ACTIVE_NATIVE" ]; then
        printf '  %sMode:%s      %snative login (nothing injected — same as running claude)%s\n' \
            "${C_BOLD}" "${C_RESET}" "${C_DIM}" "${C_RESET}"
        caffeine_line
        printf "\n"
        return
    fi

    printf '  %sModel:%s     %s\n' "${C_BOLD}" "${C_RESET}" "$ACTIVE_MODEL"
    if [ -n "$ACTIVE_BASE_URL" ]; then
        printf '  %sBase URL:%s  %s\n' "${C_BOLD}" "${C_RESET}" "$ACTIVE_BASE_URL"
    else
        printf '  %sBase URL:%s  %s(native Anthropic API)%s\n' "${C_BOLD}" "${C_RESET}" "${C_DIM}" "${C_RESET}"
    fi
    printf '  %sAPI Key:%s   %s\n' "${C_BOLD}" "${C_RESET}" "$(mask_key "$ACTIVE_API_KEY")"
    load_limits "$ACTIVE_PROVIDER" "$ACTIVE_MODEL" "$ACTIVE_BASE_URL"
    if [ -n "$CTX_TOKENS" ]; then
        printf '  %sContext:%s   %s tokens %s(%s)%s\n' "${C_BOLD}" "${C_RESET}" \
            "$(fmt_tokens "$CTX_TOKENS")" "${C_DIM}" "$CTX_SOURCE" "${C_RESET}"
    else
        printf '  %sContext:%s   %sunknown (%s)%s\n' "${C_BOLD}" "${C_RESET}" \
            "${C_DIM}" "$CTX_SOURCE" "${C_RESET}"
    fi
    # Caffeine belongs here, unlike notify/sync: it changes what a launch does.
    caffeine_line
    printf "\n"
}

cmd_config() {
    require_config
    "${EDITOR:-vi}" "$CONFIG_FILE"
}

# Rewrite provider= and model= inside [_defaults] only — one awk pass, same
# whitespace rules as config_set. Keys absent from the section are not added.
write_defaults() {
    local provider="$1" model="$2" tmpfile
    tmpfile=$(mktemp)
    awk -v p="$provider" -v m="$model" '
        /^[ \t]*\[_defaults\][ \t]*$/     { in_d = 1; print; next }
        /^[ \t]*\[/                       { in_d = 0; print; next }
        in_d && /^[ \t]*provider[ \t]*=/  { print "provider=" p; next }
        in_d && /^[ \t]*model[ \t]*=/     { print "model=" m; next }
        { print }
    ' "$CONFIG_FILE" > "$tmpfile"
    mv "$tmpfile" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}


# --- Keep awake ---
# `ccs caffeine` holds an OS sleep assertion for exactly as long as the claude
# process lives. It changes no permanent system setting and writes nothing
# outside ~/.claude-provider/config: the whole feature is a command prefix
# inserted between `env` and `claude` in cmd_launch.

# The effective mode: --caffeine/--no-caffeine first, then [_defaults] caffeine=.
# parse_config runs here because load_state returns early — without ever parsing
# the config — whenever an active state file exists, which would make a
# configured caffeine= read as empty.
caffeine_mode() {
    local mode="$CAFFEINE_OVERRIDE"
    if [ -z "$mode" ]; then
        parse_config || true
        mode=$(get_cfg "_defaults" "caffeine")
    fi
    case "$mode" in
        on|true|system) printf 'system' ;;
        display)        printf 'display' ;;
        ""|off|false)   printf 'off' ;;
        *)
            warn "unknown caffeine mode '$mode' — treating it as off (use system or display)"
            printf 'off'
            ;;
    esac
}

# Resolve $mode into CAFFEINE_CMD for this OS.
# Returns 1 only when a mode was asked for and no keep-awake tool exists — the
# caller warns and launches anyway, never dies.
caffeine_resolve() {
    local mode="$1" what
    CAFFEINE_CMD=""
    if [ "$mode" = "off" ]; then
        return 0
    fi

    # Every word below is space-free on purpose (--why=ccs-session, not
    # --why="ccs session"): CAFFEINE_CMD is spliced unquoted into the exec.
    case "$(uname -s 2>/dev/null || printf 'unknown')" in
        Darwin)
            if command -v caffeinate >/dev/null 2>&1; then
                # -i idle system, -m disk, -s system sleep; -d also holds the display
                if [ "$mode" = "display" ]; then
                    CAFFEINE_CMD="caffeinate -dims"
                else
                    CAFFEINE_CMD="caffeinate -ims"
                fi
            fi
            ;;
        Linux)
            # WSL reports Linux but has no reach into the Windows host's power
            # management: systemd-inhibit would hold the VM awake while Windows
            # sleeps anyway. Say so instead of pretending it worked.
            if grep -qi microsoft "$CCS_OSRELEASE" 2>/dev/null; then
                warn "WSL cannot keep the Windows host awake — set it in Windows' power settings"
                return 1
            fi
            if command -v systemd-inhibit >/dev/null 2>&1; then
                # sleep blocks suspend; idle also blocks the idle timer that
                # blanks the screen, which is the display mode's whole point
                what="sleep"
                if [ "$mode" = "display" ]; then what="sleep:idle"; fi
                CAFFEINE_CMD="systemd-inhibit --what=$what --who=ccs --why=ccs-session --mode=block"
            elif command -v gnome-session-inhibit >/dev/null 2>&1; then
                what="suspend"
                if [ "$mode" = "display" ]; then what="suspend:idle"; fi
                CAFFEINE_CMD="gnome-session-inhibit --inhibit $what --reason ccs-session"
            fi
            ;;
    esac

    [ -n "$CAFFEINE_CMD" ]
}

# The one-line state, shared by `ccs status` and `ccs caffeine status`
caffeine_line() {
    local mode
    mode=$(caffeine_mode)
    if [ "$mode" = "off" ]; then
        printf '  %sCaffeine:%s  off\n' "${C_BOLD}" "${C_RESET}"
        return 0
    fi
    if caffeine_resolve "$mode"; then
        printf '  %sCaffeine:%s  on %s(%s — %s)%s\n' "${C_BOLD}" "${C_RESET}" \
            "${C_DIM}" "$mode" "$CAFFEINE_CMD" "${C_RESET}"
    else
        printf '  %sCaffeine:%s  on %s(%s — no keep-awake tool on this system)%s\n' \
            "${C_BOLD}" "${C_RESET}" "${C_DIM}" "$mode" "${C_RESET}"
    fi
}

# A sleep assertion is a live process, not an env var — `ccs env` cannot carry
# it. Say so on stderr so `eval "$(ccs env)"` keeps a clean stdout.
caffeine_env_note() {
    if [ "$(caffeine_mode)" != "off" ]; then
        printf '%sccs caffeine is on, but env vars cannot keep a machine awake — launch with %sccs%s%s to get it.%s\n' \
            "${C_DIM}" "${C_RESET}${C_BOLD}" "${C_RESET}" "${C_DIM}" "${C_RESET}" >&2
    fi
}

caffeine_on() {
    local mode="${1:-system}"
    case "$mode" in
        system|display) ;;
        *) die "Unknown caffeine mode '$mode'. Usage: ccs caffeine on [system|display]" ;;
    esac
    config_set "_defaults" "caffeine" "$mode"
    if [ "$mode" = "display" ]; then
        info "Caffeine on (display) — the machine and the screen stay awake while claude runs"
    else
        info "Caffeine on (system) — the machine stays awake while claude runs, the screen may sleep"
    fi
    if caffeine_resolve "$mode"; then
        printf '    Wrapper: %s%s%s\n' "${C_BOLD}" "$CAFFEINE_CMD" "${C_RESET}"
    else
        warn "no keep-awake tool found on this system — sessions will launch, just not caffeinated"
    fi
}

caffeine_off() {
    config_set "_defaults" "caffeine" "off"
    info "Caffeine off — claude sessions no longer keep the machine awake"
}

caffeine_status() {
    printf '\n'
    caffeine_line
    printf '\n'
}

cmd_caffeine() {
    local sub="${1:-status}"
    if [ $# -gt 0 ]; then shift; fi
    case "$sub" in
        on)     caffeine_on "$@" ;;
        off)    caffeine_off ;;
        status) caffeine_status ;;
        *)      die "Unknown caffeine subcommand '$sub'. Usage: ccs caffeine on|off|status" ;;
    esac
}

# No provider usable — run claude untouched instead of failing
launch_vanilla() {
    if ! command -v claude >/dev/null 2>&1; then
        die "claude command not found. Install Claude Code first."
    fi
    warn "no provider configured — launching vanilla claude (run 'ccs use <provider>' to switch)"
    # Keep awake still applies: it is about the machine, not about the provider.
    # shellcheck disable=SC2086  # intentional: empty means "no wrapper"
    exec $CAFFEINE_CMD claude "$@"
}

cmd_launch() {
    # Config sync runs before anything provider-related: it is about ~/.claude,
    # not about which model answers. It can never stop the launch.
    sync_auto_launch

    # Resolved before load_state so the vanilla fallback below is caffeinated
    # too — a missing tool warns and launches anyway, it is never fatal.
    if ! caffeine_resolve "$(caffeine_mode)"; then
        warn "no keep-awake tool found on this system — the session will not stay awake"
    fi

    # Active state first, then [_defaults]; neither usable means vanilla claude
    if ! load_state; then
        launch_vanilla "$@"
    fi

    # Verify claude is available
    if ! command -v claude >/dev/null 2>&1; then
        die "claude command not found. Install Claude Code first."
    fi

    # Native login — claude exactly as it runs on its own: nothing set, and the
    # vars ccs manages scrubbed so a stale `eval "$(ccs env)"` from another
    # provider cannot survive into this session. The wrapper still applies:
    # keeping the machine awake is about the machine, not about the provider.
    if [ -n "$ACTIVE_NATIVE" ]; then
        if [ -n "$CAFFEINE_CMD" ]; then
            info "Launching claude ${C_DIM}(native login, caffeinated)${C_RESET}"
        else
            info "Launching claude ${C_DIM}(native login)${C_RESET}"
        fi
        # shellcheck disable=SC2086  # intentional: empty means "no wrapper"
        exec env \
            -u ANTHROPIC_API_KEY \
            -u ANTHROPIC_AUTH_TOKEN \
            -u ANTHROPIC_BASE_URL \
            -u ANTHROPIC_MODEL \
            -u ANTHROPIC_DEFAULT_OPUS_MODEL \
            -u ANTHROPIC_DEFAULT_SONNET_MODEL \
            -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
            -u CLAUDE_CODE_SUBAGENT_MODEL \
            -u ANTHROPIC_SMALL_FAST_MODEL \
            -u CLAUDE_CODE_MAX_CONTEXT_TOKENS \
            -u CLAUDE_CODE_MAX_OUTPUT_TOKENS \
            $CAFFEINE_CMD claude "$@"
    fi

    load_limits "$ACTIVE_PROVIDER" "$ACTIVE_MODEL" "$ACTIVE_BASE_URL"

    local detail=""
    if [ -n "$CTX_TOKENS" ]; then
        detail="$(fmt_tokens "$CTX_TOKENS") context"
    fi
    if [ -n "$CAFFEINE_CMD" ]; then
        detail="${detail:+$detail, }caffeinated"
    fi
    if [ -n "$detail" ]; then
        info "Launching claude with ${C_BOLD}${ACTIVE_PROVIDER}${C_RESET} / ${C_CYAN}${ACTIVE_MODEL}${C_RESET} ${C_DIM}(${detail})${C_RESET}"
    else
        info "Launching claude with ${C_BOLD}${ACTIVE_PROVIDER}${C_RESET} / ${C_CYAN}${ACTIVE_MODEL}${C_RESET}"
    fi

    # `env -u` scrubs conflicting vars inherited from the shell (e.g. a
    # previous `eval "$(ccs env)"` for another provider). Not strictly
    # POSIX but supported everywhere (GNU, BSD/macOS, busybox).
    # The env list is fixed at parse time, so the two token limits are built as
    # words that expand to nothing when unknown. Both are digits-only (is_uint
    # in load_limits), so the unquoted expansion below cannot word-split.
    local ctx_env="" out_env=""
    if [ -n "$CTX_TOKENS" ]; then
        ctx_env="CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CTX_TOKENS"
    fi
    if [ -n "$OUT_TOKENS" ]; then
        out_env="CLAUDE_CODE_MAX_OUTPUT_TOKENS=$OUT_TOKENS"
    fi

    if [ -n "$ACTIVE_BASE_URL" ]; then
        # Third-party provider: use ANTHROPIC_AUTH_TOKEN to avoid
        # the "Detected a custom API key" interactive prompt
        # shellcheck disable=SC2086  # intentional: empty means "do not set"
        exec env \
            -u ANTHROPIC_API_KEY \
            -u CLAUDE_CODE_MAX_CONTEXT_TOKENS \
            -u CLAUDE_CODE_MAX_OUTPUT_TOKENS \
            ANTHROPIC_BASE_URL="$ACTIVE_BASE_URL" \
            ANTHROPIC_AUTH_TOKEN="$ACTIVE_API_KEY" \
            ANTHROPIC_MODEL="$ACTIVE_MODEL" \
            ANTHROPIC_DEFAULT_OPUS_MODEL="$ACTIVE_OPUS" \
            ANTHROPIC_DEFAULT_SONNET_MODEL="$ACTIVE_SONNET" \
            ANTHROPIC_DEFAULT_HAIKU_MODEL="$ACTIVE_HAIKU" \
            CLAUDE_CODE_SUBAGENT_MODEL="$ACTIVE_SONNET" \
            ANTHROPIC_SMALL_FAST_MODEL="$ACTIVE_HAIKU" \
            $ctx_env $out_env \
            $CAFFEINE_CMD claude "$@"
    else
        # Native Anthropic — use ANTHROPIC_API_KEY, no BASE_URL override.
        # Claude Code ignores CLAUDE_CODE_MAX_CONTEXT_TOKENS for claude-* ids
        # anyway, so the native setup is left entirely alone.
        # shellcheck disable=SC2086  # intentional: empty means "no wrapper"
        exec env \
            -u ANTHROPIC_BASE_URL \
            -u ANTHROPIC_AUTH_TOKEN \
            -u ANTHROPIC_DEFAULT_OPUS_MODEL \
            -u ANTHROPIC_DEFAULT_SONNET_MODEL \
            -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
            -u CLAUDE_CODE_SUBAGENT_MODEL \
            -u ANTHROPIC_SMALL_FAST_MODEL \
            -u CLAUDE_CODE_MAX_CONTEXT_TOKENS \
            -u CLAUDE_CODE_MAX_OUTPUT_TOKENS \
            ANTHROPIC_API_KEY="$ACTIVE_API_KEY" \
            ANTHROPIC_MODEL="$ACTIVE_MODEL" \
            $CAFFEINE_CMD claude "$@"
    fi
}

cmd_env() {
    local rc=0
    load_state || rc=$?
    case "$rc" in
        1) die "No active provider and no default configured." ;;
        2) validate_api_key "$(get_cfg "_defaults" "provider")" ;;
    esac

    # Native login: the whole point is that nothing is set. Unset everything ccs
    # manages so a previous eval of another provider cannot linger.
    if [ -n "$ACTIVE_NATIVE" ]; then
        printf 'unset ANTHROPIC_API_KEY 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_AUTH_TOKEN 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_BASE_URL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_OPUS_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_SONNET_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_HAIKU_MODEL 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_SUBAGENT_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_SMALL_FAST_MODEL 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_MAX_CONTEXT_TOKENS 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_MAX_OUTPUT_TOKENS 2>/dev/null || true\n'
        caffeine_env_note
        return
    fi

    load_limits "$ACTIVE_PROVIDER" "$ACTIVE_MODEL" "$ACTIVE_BASE_URL"

    if [ -n "$ACTIVE_BASE_URL" ]; then
        # Third-party: ANTHROPIC_AUTH_TOKEN (no prompt), unset API_KEY
        printf "export ANTHROPIC_BASE_URL='%s'\n" "$ACTIVE_BASE_URL"
        printf "export ANTHROPIC_AUTH_TOKEN='%s'\n" "$ACTIVE_API_KEY"
        printf 'unset ANTHROPIC_API_KEY 2>/dev/null || true\n'
        printf "export ANTHROPIC_DEFAULT_OPUS_MODEL='%s'\n" "$ACTIVE_OPUS"
        printf "export ANTHROPIC_DEFAULT_SONNET_MODEL='%s'\n" "$ACTIVE_SONNET"
        printf "export ANTHROPIC_DEFAULT_HAIKU_MODEL='%s'\n" "$ACTIVE_HAIKU"
        printf "export CLAUDE_CODE_SUBAGENT_MODEL='%s'\n" "$ACTIVE_SONNET"
        printf "export ANTHROPIC_SMALL_FAST_MODEL='%s'\n" "$ACTIVE_HAIKU"
        if [ -n "$CTX_TOKENS" ]; then
            printf "export CLAUDE_CODE_MAX_CONTEXT_TOKENS='%s'\n" "$CTX_TOKENS"
        else
            printf 'unset CLAUDE_CODE_MAX_CONTEXT_TOKENS 2>/dev/null || true\n'
        fi
        if [ -n "$OUT_TOKENS" ]; then
            printf "export CLAUDE_CODE_MAX_OUTPUT_TOKENS='%s'\n" "$OUT_TOKENS"
        else
            printf 'unset CLAUDE_CODE_MAX_OUTPUT_TOKENS 2>/dev/null || true\n'
        fi
    else
        # Native Anthropic: ANTHROPIC_API_KEY, unset AUTH_TOKEN.
        # Also unset the tier vars a previous third-party `eval $(ccs env)`
        # may have exported — otherwise claude keeps stale models.
        printf 'unset ANTHROPIC_BASE_URL 2>/dev/null || true\n'
        printf "export ANTHROPIC_API_KEY='%s'\n" "$ACTIVE_API_KEY"
        printf 'unset ANTHROPIC_AUTH_TOKEN 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_OPUS_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_SONNET_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_DEFAULT_HAIKU_MODEL 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_SUBAGENT_MODEL 2>/dev/null || true\n'
        printf 'unset ANTHROPIC_SMALL_FAST_MODEL 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_MAX_CONTEXT_TOKENS 2>/dev/null || true\n'
        printf 'unset CLAUDE_CODE_MAX_OUTPUT_TOKENS 2>/dev/null || true\n'
    fi
    printf "export ANTHROPIC_MODEL='%s'\n" "$ACTIVE_MODEL"
    caffeine_env_note
}

