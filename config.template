# Claude Code Switch - Provider Configuration
#
# Format:
#   [provider_name]
#   base_url=https://...
#   api_key=your-api-key-here
#   model=model-name          (main model — maps to sonnet/default tier)
#   opus_model=model-name     (optional, for /models opus tier)
#   haiku_model=model-name    (optional, for /models haiku tier + fast tasks)
#   context_tokens=200000     (optional, pins the context window — plain integer)
#   max_output_tokens=64000   (optional, pins the output limit — plain integer)
#
# Special: [anthropic] does not need base_url (uses native API)
# Special: [_defaults] section sets global defaults
# opus_model and haiku_model fall back to model if empty
#
# context_tokens / max_output_tokens are looked up automatically from
# llm-models when it is installed, so leave them empty unless a lookup gets it
# wrong (check with `ccs models`). Plain integers only — "200k" is not valid.
# Set auto_context=false in [_defaults] to disable the lookup entirely.

[_defaults]
provider=anthropic
model=claude-sonnet-5
auto_context=true

[anthropic]
base_url=
api_key=
model=claude-sonnet-5

[openrouter]
base_url=https://openrouter.ai/api
api_key=
model=anthropic/claude-sonnet-4

[deepseek]
base_url=https://api.deepseek.com/anthropic
api_key=
model=deepseek-chat
opus_model=deepseek-reasoner

[zai]
base_url=https://api.z.ai/api/anthropic
api_key=
model=glm-5.1
opus_model=glm-5.1
haiku_model=glm-4.7

[kimi]
base_url=https://api.moonshot.ai/anthropic
api_key=
model=kimi-k2.5

[qwen]
base_url=https://dashscope-intl.aliyuncs.com/apps/anthropic
api_key=
model=qwen3.5-plus
haiku_model=qwen3-coder-plus

[minimax]
base_url=https://api.minimax.io/anthropic
api_key=
model=MiniMax-M2.7
haiku_model=MiniMax-M2.5

[doubao]
base_url=https://ark.cn-beijing.volces.com/api/coding
api_key=
model=doubao-seed-code-preview-latest
# Volcengine is not in the llm-models catalogue, so pin the window by hand
context_tokens=262144

[custom]
base_url=
api_key=
model=
