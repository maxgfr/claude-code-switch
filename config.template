# Claude Code Switch - Provider Configuration
#
# Format:
#   [provider_name]
#   base_url=https://...
#   api_key=your-api-key-here
#   model=model-name          (main model — maps to sonnet/default tier)
#   opus_model=model-name     (optional, for /models opus tier)
#   haiku_model=model-name    (optional, for /models haiku tier + fast tasks)
#   context_tokens=200000     (optional, pins the context window — plain integer)
#   max_output_tokens=64000   (optional, pins the output limit — plain integer)
#
# Special: [anthropic] does not need base_url (uses native API)
# Special: [_defaults] section sets global defaults
# opus_model and haiku_model fall back to model if empty
#
# context_tokens / max_output_tokens are looked up automatically from
# llm-models when it is installed, so leave them empty unless a lookup gets it
# wrong (check with `ccs models`). Plain integers only — "200k" is not valid.
# Set auto_context=false in [_defaults] to disable the lookup entirely.

[_defaults]
provider=anthropic
model=claude-sonnet-5
auto_context=true
# Keep the machine awake while claude runs — see `ccs caffeine`
#   off | system (screen may sleep) | display (screen stays lit)
caffeine=off

# Config backup / sync — see `ccs sync`. Normally written by `ccs sync init`.
# Sections starting with _ are reserved: they are never treated as providers.
# Values must not carry trailing comments (everything after = is the value).
#   remote       git URL of the gist or repo holding your Claude Code config
#   kind         repo | gist (a gist stores a flattened tree so GitHub shows it)
#   include_ccs  true also backs up this file, with every api_key= blanked out
#   auto_launch  true syncs on every `ccs` launch (never blocks the launch)
#   auto_hooks   managed by `ccs sync hooks on|off` — do not set by hand
#   prune        true mirrors the remote on pull, false only ever adds
[_sync]
remote=
kind=repo
include_ccs=false
auto_launch=false
auto_hooks=false
prune=true

[anthropic]
base_url=
api_key=
model=claude-sonnet-5

[openrouter]
